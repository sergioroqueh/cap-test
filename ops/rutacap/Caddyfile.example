# Ejemplo sin secretos. No cargar hasta disponer del VPS y DNS autorizado.
# IPv4 de origen directamente en OVH DNS, sin CDN ni proxy compartido.
rutacap.es {
    root * /srv/rutacap/current
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @uncached path / /index.html /sw.js /data/*
    header @uncached Cache-Control "no-cache, must-revalidate"

    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # File-only routes: absent JSON/JS must return 404, never index.html.
    handle /data/* {
        file_server
    }
    handle /assets/* {
        file_server
    }
    handle /sw.js {
        file_server
    }
    handle /manifest.webmanifest {
        file_server
    }
    handle /icon.svg {
        file_server
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}

www.rutacap.es {
    redir https://rutacap.es{uri} permanent
}
